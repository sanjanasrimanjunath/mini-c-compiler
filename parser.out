    NUMBER          shift and go to state 18
    IDENTIFIER      shift and go to state 14
    LPAREN          shift and go to state 19

    expression                     shift and go to state 15
    term                           shift and go to state 16
    factor                         shift and go to state 17

state 11

    (5) statement -> FLOAT IDENTIFIER . SEMICOLON

    SEMICOLON       shift and go to state 20


state 12

    (7) statement -> PRINT LPAREN . IDENTIFIER RPAREN SEMICOLON

    IDENTIFIER      shift and go to state 21


state 13

    (4) statement -> INT IDENTIFIER SEMICOLON .

    INT             reduce using rule 4 (statement -> INT IDENTIFIER SEMICOLON .)
    FLOAT           reduce using rule 4 (statement -> INT IDENTIFIER SEMICOLON .)
